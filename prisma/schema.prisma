// Schéma Prisma — guitareapprentissage
// App mono-utilisateur : aucune notion de compte, toutes les données sont globales.
// Dev : SQLite (file:./dev.db). Prod : Turso (libSQL) via @prisma/adapter-libsql,
// même dialecte SQLite — la migration est triviale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// THÉORIE — progression des leçons + répétition espacée (SM-2)
// Le CONTENU des leçons vit dans le code (src/content/lessons),
// la base ne stocke que la progression.
// ─────────────────────────────────────────────────────────────

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String    @unique // slug d'une leçon "as code"
  status      String    @default("not_started") // not_started | in_progress | completed
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Carte de révision espacée par notion (SM-2 simplifié). Elle porte l'état
/// courant (agrégat de lecture) ; l'historique des révisions vit dans
/// PracticeEvent (source de vérité).
model ReviewItem {
  id           String    @id @default(cuid())
  conceptId    String    @unique // ex: "intervalle-tierce-majeure"
  easeFactor   Float     @default(2.5)
  intervalDays Int       @default(0)
  repetitions  Int       @default(0)
  dueDate      DateTime
  lastReviewed DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────
// JOURNAL — source de vérité (append-only).
// Chaque réponse d'oreille et chaque révision espacée y écrit une
// ligne. EarStat et ReviewItem ne sont plus que des agrégats de
// LECTURE dérivés de ce journal ; on ne réécrit jamais l'historique.
// ─────────────────────────────────────────────────────────────

model PracticeEvent {
  id        String   @id @default(cuid())
  type      String // ex: "ear_interval", "ear_chord_quality", "review"
  refId     String // sujet concerné : sous-type d'oreille ou conceptId SR
  correct   Boolean? // réponses d'oreille (juste / faux)
  quality   Int? // note SM-2 (0–5) des révisions espacées
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// OREILLE — agrégat de LECTURE par type d'exercice (pour pondérer
// vers ce qui est raté), dérivé de PracticeEvent ; le détail
// quotidien vit dans DailyStat.
// ─────────────────────────────────────────────────────────────

model EarStat {
  id        String   @id @default(cuid())
  exercise  String // interval | chord_quality | progression | degree | pitch
  subtype   String? // ex: "tierce_majeure", "accord_mineur"
  attempts  Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([exercise, subtype])
}

// ─────────────────────────────────────────────────────────────
// TECHNIQUE — réglages par exercice + historique de tempo.
// La définition des exercices vit dans le code.
// ─────────────────────────────────────────────────────────────

model ExerciseSetting {
  id         String   @id @default(cuid())
  exerciseId String   @unique // slug d'un exercice "as code"
  targetBpm  Int
  currentBpm Int
  updatedAt  DateTime @updatedAt
}

model TempoRecord {
  id         String   @id @default(cuid())
  exerciseId String
  bpm        Int
  achievedAt DateTime @default(now())

  @@index([exerciseId])
}

// ─────────────────────────────────────────────────────────────
// PROGRESSION — sessions de pratique, série de jours, stats.
// ─────────────────────────────────────────────────────────────

model PracticeSession {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int       @default(0)
  kind        String? // routine | libre | metronome | oreille | technique

  /// Mesures brutes de la séance, en JSON. JAMAIS d'audio : le micro sert au
  /// calcul, le signal est jeté, et seuls les nombres arrivent ici.
  metrics  String?
  /// Retour rédigé à partir de ces mesures. Texte, pas de note ni de score.
  feedback String?
}

/// Une ligne par jour (date locale) → série de jours + graphes.
model DailyStat {
  id          String   @id @default(cuid())
  date        String   @unique // "YYYY-MM-DD" (heure locale)
  practiceSec Int      @default(0)
  lessonsDone Int      @default(0)
  earAttempts Int      @default(0)
  earCorrect  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// RÉPERTOIRE — morceaux saisis à la main (titres + notes libres,
// jamais de tablatures : droits d'auteur).
// ─────────────────────────────────────────────────────────────

model RepertoireSong {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  songKey   String? // tonalité, ex: "Am", "G"
  status    String   @default("learning") // learning | acquired
  targetBpm Int?
  notes     String? // notes libres
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
