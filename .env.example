# ─────────────────────────────────────────────────────────────
# Variables d'environnement — guitareapprentissage
# Copier vers .env (dev) ou configurer sur Vercel (prod).
# ─────────────────────────────────────────────────────────────

# Auth : mot de passe unique de l'application (aucun compte).
APP_PASSWORD="change-moi"

# Secret de signature du cookie de session (HMAC).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="chaine-aleatoire-longue-et-secrete"

# ─── Base de données ───
# DEV : SQLite local (fichier dans prisma/).
DATABASE_URL="file:./prisma/dev.db"

# PROD : Turso (libSQL). Décommenter et renseigner sur Vercel.
# Quand TURSO_DATABASE_URL est défini, le client Prisma bascule sur l'adapter libSQL.
# TURSO_DATABASE_URL="libsql://<nom-base>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<jeton-turso>"
